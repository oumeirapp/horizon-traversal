{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon Traversal",
  "version": "0.1.0",
  "identifier": "com.horizon.traversal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Horizon Traversal",
        "width": 1080,
        "height": 820,
        "minWidth": 820,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "native-assets.json": "native-assets.json",
      "binaries/THIRD_PARTY_NOTICES.md": "binaries/THIRD_PARTY_NOTICES.md",
      "binaries/licenses": "binaries/licenses",
      "resources/licenses/pdfium": "resources/licenses/pdfium"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": ["resources/native/libpdfium.dylib"],
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
