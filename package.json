{
  "name": "horizon-traversal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "prepare:pdfium": "node scripts/prepare-pdfium.mjs",
    "prepare:source-offer": "node scripts/prepare-native-source-offer.mjs",
    "verify:source-offer": "node scripts/verify-native-source-offer.mjs",
    "verify:native": "node scripts/verify-native-assets.mjs",
    "bundle:macos": "node scripts/bundle.mjs macos",
    "bundle:windows": "node scripts/bundle.mjs windows",
    "smoke:package": "node scripts/smoke/run-package-smoke.mjs",
    "test": "vitest run && npm run test:native-scripts",
    "test:native-scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "extract-zip": "^2.0.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
